# systemd unit for the AML compliance assistant.
# Install:  sudo cp deploy/aml-atb.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now aml-atb

[Unit]
Description=AML Uygunluq Komekcisi (AML compliance assistant)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aml
Group=aml
WorkingDirectory=/opt/aml-atb

# Secrets live here, not in the unit file. Must be chmod 600, owned by root.
EnvironmentFile=/etc/aml-atb/aml-atb.env

ExecStart=/usr/bin/node /opt/aml-atb/dist/src/index.js
Restart=on-failure
RestartSec=5s

# The audit trail is the only thing this service needs to write.
StateDirectory=aml-atb
ReadWritePaths=/var/lib/aml-atb/audit
UMask=0077

# Hardening: the process reads a corpus and talks to one API. Nothing else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aml-atb

[Install]
WantedBy=multi-user.target
