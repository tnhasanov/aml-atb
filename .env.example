# ---------------------------------------------------------------------------
# Anthropic API
# ---------------------------------------------------------------------------
# Leave ANTHROPIC_API_KEY unset if you authenticate with `ant auth login`
# (the SDK picks up the stored profile automatically).
# The value must not contain whitespace or newlines - the app refuses to start
# otherwise, because an invalid header leaks the key into error text.
ANTHROPIC_API_KEY=

# Route API traffic through an institutional gateway or DLP proxy without any
# code change. Leave unset to talk to api.anthropic.com directly.
# ANTHROPIC_BASE_URL=https://llm-gateway.internal.example.az

AML_MODEL=claude-opus-5
# low | medium | high | xhigh | max
AML_EFFORT=high
# Must leave room for adaptive thinking as well as the answer; a truncated
# compliance answer is refused rather than shown as complete.
AML_MAX_TOKENS=32000

# ---------------------------------------------------------------------------
# Network and authentication
# ---------------------------------------------------------------------------
PORT=3000
# Loopback by default. Only widen this if something else terminates TLS and
# authentication in front of the process.
BIND_HOST=127.0.0.1

# proxy = a reverse proxy authenticates the user and passes the username in a
#         header (the intended deployment - see deploy/nginx.conf)
# none  = no authentication; permitted only on a loopback bind, for development
AUTH_MODE=proxy
AUTH_USER_HEADER=x-forwarded-user

# Shared secret proving a request arrived via the proxy. Without it, anyone who
# can reach the port directly can assert any identity by setting the header.
# Generate with: openssl rand -hex 32
AUTH_SHARED_SECRET=
AUTH_SECRET_HEADER=x-auth-secret

# ---------------------------------------------------------------------------
# Audit trail
# ---------------------------------------------------------------------------
# Contains pasted customer data. Written 0600 in a 0700 directory, owned by the
# service account. Use an absolute path in production.
AUDIT_DIR=./audit
# Refuse to answer if the audit trail cannot be written. An AML advisory tool
# with no record-keeping should not be serving.
AUDIT_FAIL_CLOSED=true

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
AML_RATE_LIMIT_PER_MINUTE=12
AML_MAX_CONCURRENT_TURNS=4
AML_SESSION_IDLE_MS=3600000
AML_UPSTREAM_TIMEOUT_MS=180000
