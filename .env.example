# Anthropic API credentials.
# Leave ANTHROPIC_API_KEY unset if you authenticate with `ant auth login`
# (the SDK picks up the stored profile automatically).
ANTHROPIC_API_KEY=

# Model + reasoning effort.
AML_MODEL=claude-opus-5
AML_EFFORT=high

# Server
PORT=3000

# Where the tamper-evident audit trail is written (JSON Lines, one event per line).
AUDIT_DIR=./audit
